# Referee System - Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit a populated copy of this file.

# ---------------------------------------------------------------------------
# Operator authentication (REQUIRED in production)
# ---------------------------------------------------------------------------
# One secret authorises both the API (as a key) and the browser console (as a
# session cookie). The service fails closed in production when this is unset:
# every route answers 503 rather than serving unauthenticated.
#
#   INTERNAL_API_KEY      - the operator key
#   REFEREE_INTERNAL_KEY  - accepted alias for INTERNAL_API_KEY
#   REFEREE_API_KEY       - accepted alias; also used by the Python core
#
# Set exactly one of them to a long random value.
INTERNAL_API_KEY=
REFEREE_INTERNAL_KEY=
REFEREE_API_KEY=

# Deployment mode. "production" (the default) makes the service fail closed
# when no operator key is configured. "development" lets it run open, which is
# only appropriate on a workstation or in CI.
REFEREE_ENV=development

# Whether the browser session cookie carries the `Secure` attribute.
#   unset  - follow X-Forwarded-Proto, and default to Secure in production
#   1/true - always Secure (correct behind TLS)
#   0/false- never Secure. Needed only for a self-hosted plain-HTTP
#            deployment; the browser drops a Secure cookie served over HTTP.
REFEREE_COOKIE_SECURE=

# Requests per minute per client IP accepted by the Python core.
REFEREE_RATE_LIMIT_PER_MIN=60

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3 bucket used for prediction CSV uploads (presigned URL flow)
S3_UPLOAD_BUCKET=

# ---------------------------------------------------------------------------
# AI / LLM
# ---------------------------------------------------------------------------
# Google Gemini - used for raw_text claim extraction and auditor critique
GEMINI_API_KEY=
# Mistral - used for the Mistral generate endpoint
MISTRAL_API_KEY=

# ---------------------------------------------------------------------------
# referee-core Python Engine
# ---------------------------------------------------------------------------
# Base URL of the running FastAPI referee-core service.
# When set, the TypeScript orchestrator will route audit computations through
# the deterministic Python engine instead of the in-process heuristic tools.
# Example: http://localhost:8000
REFEREE_CORE_URL=

# ---------------------------------------------------------------------------
# Ledger Persistence
# ---------------------------------------------------------------------------
# Absolute path to the ledger data file. The SQLite store is used when this is
# set; leave unset for in-memory-only mode (data lost on restart).
# A path ending in .json is rewritten to .sqlite.
# Example: /var/data/referee-ledger.sqlite
LEDGER_DATA_PATH=

# ---------------------------------------------------------------------------
# Report signing
# ---------------------------------------------------------------------------
# Ed25519 private key (PEM) used to sign audit reports. When unset, reports
# are signed with an ephemeral development key, which means signatures cannot
# be verified after a restart. Set it in production.
# Example: /var/data/referee-signing-key.pem
REFEREE_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Compute Offload
# ---------------------------------------------------------------------------
# Allowlisted compute targets (comma-separated)
COMPUTE_OFFLOAD_TARGETS=tumortwin,kaggle,cloudflare

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
