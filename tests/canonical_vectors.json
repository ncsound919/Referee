[
  { "name": "empty object", "input": {}, "expected": "{}" },
  { "name": "sorted keys", "input": { "b": 2, "a": 1 }, "expected": "{\"a\":1,\"b\":2}" },
  { "name": "float rounding", "input": { "x": 0.123456789 }, "expected": "{\"x\":0.123457}" },
  { "name": "integer stays integer", "input": { "n": 42 }, "expected": "{\"n\":42}" },
  { "name": "nested", "input": { "outer": { "z": 3, "a": 1 } }, "expected": "{\"outer\":{\"a\":1,\"z\":3}}" },
  { "name": "array", "input": { "arr": [3, 1, 2] }, "expected": "{\"arr\":[3,1,2]}" },
  { "name": "unicode", "input": { "msg": "café" }, "expected": "{\"msg\":\"café\"}" },
  { "name": "null", "input": { "v": null }, "expected": "{\"v\":null}" },
  { "name": "boolean", "input": { "flag": true }, "expected": "{\"flag\":true}" },
  { "name": "jitter collapses", "input": { "v": 0.30000000000000004 }, "expected": "{\"v\":0.3}" }
]